[Desktop Entry]
Type=Application
Name=Sample Creator
Comment=Разметка записей с диктофона и нарезка сэмплов
Exec=sample-creator %f
Icon=io.github.horhik.SampleCreator
Terminal=false
Categories=AudioVideo;Audio;
MimeType=audio/x-wav;audio/wav;audio/mpeg;audio/flac;
StartupWMClass=io.github.horhik.SampleCreator
